# ==========================================
# Backend Environment Variables
# Target file: Backend/.env
# ==========================================

# Port the Express server listens on (default fallback: 5000)
PORT=5000

# MongoDB connection string (Required - application crashes without it)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/messaging

# Secret key used for CryptoJS AES-256 message encryption at rest in MongoDB (Required)
# Generate a strong 32-byte or 64-character hex secret
MESSAGE_SECRET=your_cryptojs_aes_encryption_secret_here

# Frontend origin allowed for CORS requests and Socket.io connections
# Note: http://localhost:3000 is always allowed by default in code
FRONTEND_URL=http://localhost:3000

# TODO (Security Fix Required):
# Previous versions hardcoded a secret in controllers; ensure JWT_SECRET is set below.
# Update the codebase to use process.env.JWT_SECRET instead.
JWT_SECRET=your_jwt_secret_key_here


# ==========================================
# Frontend Environment Variables
# Target file: Frontend/chat-app/.env.local
# ==========================================

# Backend API and Socket.io server endpoint
# Development: http://localhost:5000
# Production: https://your-backend-domain.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
