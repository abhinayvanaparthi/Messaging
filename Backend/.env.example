# ==========================================
# Backend Configuration (.env)
# ==========================================

# Port the Express server listens on (default: 5000)
PORT=5000

# MongoDB connection URI (Required - server will exit if missing)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/messaging

# JWT Secret for signing and verifying authentication tokens (Required - server will exit if missing)
JWT_SECRET=your_strong_random_jwt_secret_here

# Secret key for CryptoJS AES-256 message encryption at rest (Required - server will exit if missing)
MESSAGE_SECRET=your_cryptojs_aes_secret_key_here

# Allowed origins for CORS and Socket.io (comma-separated if multiple)
ALLOWED_ORIGINS=http://localhost:3000

# Optional legacy single origin fallback
FRONTEND_URL=http://localhost:3000

# Maximum file upload size in bytes (default: 5MB = 5242880)
MAX_FILE_SIZE=5242880
